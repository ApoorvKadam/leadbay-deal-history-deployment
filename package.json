{
  "name": "leadbay-deal-history-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "leadbay-deploy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fixtures:generate": "tsx scripts/generate-synthetic-case.ts --write",
    "fixtures:check": "tsx scripts/generate-synthetic-case.ts --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm fixtures:check",
    "demo": "tsx src/cli.ts demo --case fixtures/building-materials-distributor --out artifacts/building-materials-distributor"
  },
  "dependencies": {
    "@leadbay/mcp": "0.40.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "csv-parse": "7.0.2",
    "tldts": "7.0.17",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.4",
    "tsup": "8.3.6",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.42.0"
    }
  }
}
